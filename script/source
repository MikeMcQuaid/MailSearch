#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ -z "$(git status --porcelain)" ]] || {
  printf 'Commit changes before archiving release source.\n' >&2
  exit 1
}
app=.DerivedData/Build/Products/Release/MailSearch.app
[[ "$(/usr/libexec/PlistBuddy -c 'Print MailSearchDirty' "$app/Contents/Info.plist")" == false ]] || {
  printf 'Rebuild from a clean working tree before archiving release source.\n' >&2
  exit 1
}
[[ "$(/usr/libexec/PlistBuddy -c 'Print MailSearchCommit' "$app/Contents/Info.plist")" == "$(git rev-parse HEAD)" ]] || {
  printf 'Rebuild the app from this commit before archiving its source.\n' >&2
  exit 1
}
script/prepare
python3 script/licences.py
version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist")"
root="MailSearch-${version}-source"
scratch="$(mktemp -d -t mailsearch-source)"
trap 'rm -rf "$scratch"' EXIT
git archive --prefix="$root/" HEAD | tar -x -C "$scratch"
while read -r checkout package revision; do
  git -C "$checkout" archive --prefix="$root/Dependencies/$package/" "$revision" | tar -x -C "$scratch"
done < <(
  python3 - <<'PY'
import json
from pathlib import Path
checkouts = {path.name.lower(): path.name for path in Path('.build/checkouts').iterdir()}
for pin in json.loads(Path('Package.resolved').read_text())['pins']:
    print('.build/checkouts/' + checkouts[pin['identity']], checkouts[pin['identity']], pin['state']['revision'])
pin = json.loads(Path('vendor/SwiftMail/upstream.json').read_text())
print('.build/upstream/SwiftMail.git', 'SwiftMail', pin['state']['revision'])
PY
)
tar -czf ".build/$root.tar.gz" -C "$scratch" "$root"
printf '.build/%s.tar.gz\n' "$root"
