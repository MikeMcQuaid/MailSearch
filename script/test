#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
bash Tests/ScriptTests.sh
bash Tests/AnalysisScriptTests.sh
scratch=.build
next_scratch=false
for argument in "$@"; do
  if "$next_scratch"; then
    scratch="$argument"
    next_scratch=false
  else
    case "$argument" in
    --scratch-path) next_scratch=true ;;
    --scratch-path=*) scratch="${argument#*=}" ;;
    esac
  fi
done
script/prepare "$scratch"
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  exec nice -n 10 swift test --disable-sandbox --jobs 6 "$@"
fi
exec swift test "$@"
