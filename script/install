#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
script/build
osascript -e 'quit app "MailSearch"' &>/dev/null || true
rm -rf /Applications/MailSearch.app
ditto MailSearch.app /Applications/MailSearch.app
open /Applications/MailSearch.app
printf 'Installed and relaunched /Applications/MailSearch.app.\n'
